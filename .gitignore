# IDE and OS
.vs
.vscode
.idea
.DS_Store
Thumbs.db
~$*
*.DotSettings
*.sln.docstates

# .NET build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
TestResults/
publish/

# .NET user/temp files
*.suo
*.user
*.dbmdl
*.Cache
*.tmp

# Visual Studio profiler & ReSharper
*.psess
*.vsp
_ReSharper*/

# Database runtime files
*.db
*.db-shm
*.db-wal

# Local runtime data (Consul KV cache, local OSS fallback)
data/

# Frontend
node_modules/
dist/
coverage/

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build output copied into the API host during Docker build
**/wwwroot/

# Local Git worktrees used for isolated agent tasks
.worktrees/

# Windows null device artifact (Git Bash treats "nul" as regular file)
nul

# Local git credentials (never commit)
.git-credentials

# Agent temporary credential helpers (hold plaintext secrets, never versioned)
.agent/.tmp_*
.trae/tmp/
