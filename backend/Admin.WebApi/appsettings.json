{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [{ "key": "service", "value": "Ruoyu.Study.AdminPortal" }]
        }
      }
    ]
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Ruoyu.Study.AdminPortal",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "ruoyu_admin"
  },
  "ConnectionStrings": {
    "AuditDb": "Host=localhost;Port=5432;Database=ruoyu_admin;Username=phil"
  },
  "OssAudit": {
    "ScheduledHour": 2,
    "ScheduledMinute": 0
  },
  "AdminApi": {
    "Port": 5020
  },
  "StudentService": {
    "Url": "http://localhost:5005"
  },
  "MistakeService": {
    "Url": "http://localhost:5007"
  },
  "IdentityService": {
    "Address": "http://localhost:5002",
    "AppId": "",
    "AppSecret": ""
  },
  "TeacherPortal": {
    "Url": "http://localhost:5004"
  },
  "AssistantPortal": {
    "Url": "http://localhost:5021"
  },
  "AdminPortal": {
    "AdminUserIds": []
  },
  "AdminWeb": {
    "AllowedOrigins": []
  },
  "Oss": {
    "InternalEndpoint": "localhost:8333",
    "InternalSecure": false,
    "AccessKey": "mock_access_key",
    "SecretKey": "mock_secret_key",
    "BucketName": "ruoyu-study",
    "PublicBaseUrl": "https://oss.example.com/oss"
  }
}
