{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Loki": {
    "Uri": "http://ruoyu-loki:3100"
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Ruoyu.Admin",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "ruoyu_admin"
  },
  "ConnectionStrings": {
    "AuditDb": "Host=localhost;Port=5432;Database=ruoyu_admin;Username=phil"
  },
  "OssAudit": {
    "ScheduledHour": 2,
    "ScheduledMinute": 0
  },
  "AdminApi": {
    "Port": 5020
  },
  "StudentService": {
    "Url": "http://localhost:5005"
  },
  "MistakeService": {
    "Url": "http://localhost:5007"
  },
  "HomeworkService": {
    "Url": "http://localhost:5009"
  },
  "TeacherPortal": {
    "Url": "http://localhost:5004"
  },
  "AssistantPortal": {
    "Url": "http://localhost:5021"
  },
  "AdminPortal": {
    "AdminUserIds": []
  },
  "AdminOidc": {
    "Enabled": false
  },
  "AdminWeb": {
    "AllowedOrigins": []
  },
  "Oss": {
    "InternalEndpoint": "localhost:8333",
    "InternalSecure": false,
    "AccessKey": "mock_access_key",
    "SecretKey": "mock_secret_key",
    "BucketName": "ruoyu-study",
    "PublicBaseUrl": "https://oss.example.com/oss"
  }
}
